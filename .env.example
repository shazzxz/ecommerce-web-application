# Local database: leave DATABASE_URL empty to use shoplite.db (SQLite).
# Optional PostgreSQL: set DATABASE_URL to a dedicated PostgreSQL database URL.
DATABASE_URL=
SHOPLITE_DB=./shoplite.db
JWT_SECRET=replace-this-with-a-random-secret
TOKEN_TTL_HOURS=12
CORS_ORIGINS=http://localhost:5173

# Optional: create an administrator on first startup.
ADMIN_EMAIL=admin@shoplite.local
ADMIN_PASSWORD=ChangeMe-Admin-123!
